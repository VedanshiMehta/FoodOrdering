{
  "expo": {
    "name": "FoodDelivery",
    "slug": "FoodDelivery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fooddelivery",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.FoodDelivery",
      "config": {
        "googleMapsApiKey": "AIzaSyALqzmxQp3LvPfDzW-BkEqIvpVRjLG-fjc"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Allow FoodDelivery to access your camera to take a profile photo.",
        "NSPhotoLibraryUsageDescription": "Allow FoodDelivery to access your photos to select a profile picture.",
        "NSPhotoLibraryAddUsageDescription": "Allow FoodDelivery to save profile photos to your library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.FoodDelivery",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyALqzmxQp3LvPfDzW-BkEqIvpVRjLG-fjc"
        }
      },
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow FoodDelivery to use your location."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FoodDelivery to access your photos to select a profile picture.",
          "cameraPermission": "Allow FoodDelivery to access your camera to take a profile photo."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
